#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/mnt/d/ByteLogicCore/DBX/packages/nodejs/node_modules/.pnpm/@napi-rs+cli@2.18.4/node_modules/@napi-rs/cli/node_modules:/mnt/d/ByteLogicCore/DBX/packages/nodejs/node_modules/.pnpm/@napi-rs+cli@2.18.4/node_modules:/mnt/d/ByteLogicCore/DBX/packages/nodejs/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/mnt/d/ByteLogicCore/DBX/packages/nodejs/node_modules/.pnpm/@napi-rs+cli@2.18.4/node_modules/@napi-rs/cli/node_modules:/mnt/d/ByteLogicCore/DBX/packages/nodejs/node_modules/.pnpm/@napi-rs+cli@2.18.4/node_modules:/mnt/d/ByteLogicCore/DBX/packages/nodejs/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../@napi-rs/cli/scripts/index.js" "$@"
else
  exec node  "$basedir/../@napi-rs/cli/scripts/index.js" "$@"
fi
