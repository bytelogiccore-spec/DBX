<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net6.0;net8.0</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- NuGet Package -->
    <Version>0.2.2</Version>
    <PackageId>DBX.Dotnet</PackageId>
    <Authors>ByteLogicCore</Authors>
    <Description>High-performance .NET bindings for DBX embedded database</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/bytelogiccore-spec/DBX</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bytelogiccore-spec/DBX</RepositoryUrl>
    <PackageTags>database;embedded;key-value;high-performance</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows -->
    <None Include="runtimes\win-x64\native\dbx_csharp.dll" Pack="true" PackagePath="runtimes\win-x64\native" Condition="Exists('runtimes\win-x64\native\dbx_csharp.dll')" />
    <!-- Linux -->
    <None Include="runtimes\linux-x64\native\libdbx_csharp.so" Pack="true" PackagePath="runtimes\linux-x64\native" Condition="Exists('runtimes\linux-x64\native\libdbx_csharp.so')" />
    <!-- macOS -->
    <None Include="runtimes\osx-arm64\native\libdbx_csharp.dylib" Pack="true" PackagePath="runtimes\osx-arm64\native" Condition="Exists('runtimes\osx-arm64\native\libdbx_csharp.dylib')" />
  </ItemGroup>

</Project>
